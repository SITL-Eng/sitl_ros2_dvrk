/* -*- Mode: Javascript; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
{
    "io": {
        "footpedals": "io/sawRobotIO1394-MTMR-foot-pedals.xml"
        , "watchdog-timeout": 0.05 // in seconds
        // , "period": 0.0007 //  since we can't use full broadcast
        // , "port": "udp"
        // , "firewire-protocol": "broadcast-read-write"
    }
    ,
    "operator-present": {
        "io": "io/sawRobotIO1394-MTMR-dv-head-sensor.xml"
    }
    ,
    "endoscope-focus": {
        "io": "io/sawRobotIO1394-MTML-dv-endoscope-focus.xml"
    }
    ,
    "arms":
    [
        {
            "name": "SUJ",
            "type": "SUJ_Classic",
            "io": "sawRobotIO1394-SUJ.xml",
            "kinematic": "suj-ECM-1-2-3.json"
        }
        ,
        {
            "name": "PSM1",
            "type": "PSM",
            "serial": "25976",
            "base-frame": {
                "component": "SUJ",
                "interface": "PSM1"
            }
        }
        ,
        {
            "name": "PSM2",
            "type": "PSM",
            "serial": "23388",
            "base-frame": {
                "component": "SUJ",
                "interface": "PSM2"
            }
        }
        ,
        {
            "name": "ECM",
            "type": "ECM",
            "serial": "27313",
            "base-frame": {
                "component": "SUJ",
                "interface": "ECM"
            }
        }
    ]
}
