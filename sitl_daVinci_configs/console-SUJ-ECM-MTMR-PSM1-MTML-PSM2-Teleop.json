/* -*- Mode: Javascript; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
{
    "io": {
        "footpedals": "io/sawRobotIO1394-MTMR-foot-pedals.xml"
        , "watchdog-timeout": 0.05 // in seconds
        // , "period": 0.0007 //  since we can't use full broadcast
        // , "port": "udp"
        // , "firewire-protocol": "broadcast-read-write"
    }
    ,
    "operator-present": {
        "io": "io/sawRobotIO1394-MTMR-dv-head-sensor.xml"
    }
    ,
    "endoscope-focus": {
        "io": "io/sawRobotIO1394-MTML-dv-endoscope-focus.xml"
    }
    ,
    "arms":
    [
        {
            "name": "SUJ",
            "type": "SUJ_Classic",
            "io": "sawRobotIO1394-SUJ.xml",
            "kinematic": "suj-ECM-1-2-3.json"
        }
        ,
        {
            "name": "PSM1",
            "type": "PSM",
            "serial": "25976",
            "base-frame": {
                "component": "SUJ",
                "interface": "PSM1"
            }
        }
        ,
        {
            "name": "PSM2",
            "type": "PSM",
            "serial": "23388",
            "base-frame": {
                "component": "SUJ",
                "interface": "PSM2"
            }
        }
        ,
        {
            "name": "ECM",
            "type": "ECM",
            "serial": "27313",
            "base-frame": {
                "component": "SUJ",
                "interface": "ECM"
            }
        }
        ,
        {
            "name": "MTMR",
            "type": "MTM",
            "serial": "82892",
            "base-frame": {
                "reference-frame": "HRSV",
                "transform": [[ -1.0,  0.0,          0.0,         -0.180],
                              [  0.0,  0.866025404,  0.5,          0.400],
                              [  0.0,  0.5,         -0.866025404,  0.475],
                              [  0.0,  0.0,          0.0,          1.0]]
            }
        }
        ,
        {
            "name": "MTML",
            "type": "MTM",
            "serial": "55716",
            "base-frame": {
                "reference-frame": "HRSV",
                "transform": [[ -1.0,  0.0,          0.0,          0.180],
                              [  0.0,  0.866025404,  0.5,          0.400],
                              [  0.0,  0.5,         -0.866025404,  0.475],
                              [  0.0,  0.0,          0.0,          1.0]]
            }
        }
    ]
    ,
    "psm-teleops":
    [
        {
            "mtm": "MTMR",
            "psm": "PSM1",
            "configure-parameter": {
                "component": "ECM",
                "interface": "Arm"
            }
        }
        ,
        {
            "mtm": "MTML",
            "psm": "PSM2",
            "configure-parameter": {
                "component": "ECM",
                "interface": "Arm"
            }
        }
    ]
    ,
    "ecm-teleop":
    {
        "mtm-left": "MTML",
        "mtm-right": "MTMR",
        "ecm": "ECM"
    }
}
